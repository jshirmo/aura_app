# Required for Gemini AI API calls.
# Never commit a real API key to GitHub.
# In Google AI Studio, this can be supplied through project secrets.
# In the live Render deployment, set this as a private environment variable.
GEMINI_API_KEY="your-gemini-api-key"

# Optional: public URL where the app is hosted.
# Current production deployment:
# https://aura-app-live.onrender.com
APP_URL="https://aura-app-live.onrender.com"

# Local development port. Render supplies its own PORT automatically.
PORT=3000
